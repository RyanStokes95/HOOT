<!-- Author - Ryan Stokes -->
<!-- dashLayout.ejs -->

<!--
  This is the dashboard layout template for the HOOT application. 
  It includes the HTML structure, Bootstrap CSS/JS, and a navigation bar. 
  The content of each page will be injected into the <main> tag using EJS templating.
-->

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title || "HOOT" %></title>

    <!-- Bootstrap CSS -->
    <script 
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js">
    </script>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link 
      rel="stylesheet" 
      href="/css/style.css" 
    />
  </head>

  <body class="bg-light">

    <!-- Navigation Bar Partial Injected Here-->
    <%- include ("../partials/dashNavbar") %>

    <!-- Page Content Injected Here -->
    <%- body %>

    <!-- Modals -->
    <!-- Teacher Modals -->
    <% if (user && user.role === "teacher") { %>
      <%
        const addTaskForm = include(
          "../partials/modalForms/addTask"
      ); %>

        <%- include("../partials/modal", {
            modalId: "addTaskModal",
            modalTitle: "Add Task",
            body: addTaskForm
        }) %>
      <%
        const addSubjectForm = include(
          "../partials/modalForms/addSubject"
      ); %>

      <%- include("../partials/modal", {
          modalId: "addSubjectModal",
          modalTitle: "Add Subject",
          body: addSubjectForm
      }) %>

      <%
        const addClassForm = include(
          "../partials/modalForms/addClass"
      ); %>

      <%- include("../partials/modal", {
          modalId: "addClassModal",
          modalTitle: "Add Class",
          body: addClassForm
      }) %>

      <%
        const editSubjectForm = include(
          "../partials/modalForms/editSubject"
      ); %>

      <%- include("../partials/modal", {
          modalId: "editSubjectModal",
          modalTitle: "Edit Subject",
          body: editSubjectForm
      }) %>

      <%
        const editHomeworkForm = include(
          "../partials/modalForms/editHomework"
      ); %>

      <%- include("../partials/modal", {
          modalId: "editHomeworkModal",
          modalTitle: "Edit Homework",
          body: editHomeworkForm
      }) %>

      <%
        const editBulletinForm = include(
          "../partials/modalForms/editBulletin"
      ); %>

      <%- include("../partials/modal", {
          modalId: "editBulletinModal",
          modalTitle: "Edit Bulletin",
          body: editBulletinForm
      }) %>

      <%
        const addHomeworkForm = include(
          "../partials/modalForms/addHomework"
      ); %>

      <%- include("../partials/modal", {
          modalId: "addHomeworkModal",
          modalTitle: "Add Homework",
          body: addHomeworkForm
      }) %>

      <%
        const addBulletinForm = include(
          "../partials/modalForms/addBulletin"
        ); %>

      <%- include("../partials/modal", {
          modalId: "addBulletinModal",
          modalTitle: "Add Bulletin",
          body: addBulletinForm
      }) %>

      <%
        const editTaskForm = include(
          "../partials/modalForms/editTask"
        ); %>

      <%- include("../partials/modal", {
          modalId: "editTaskModal",
          modalTitle: "Edit Task",
          body: editTaskForm
      }) %>
    <% } %>

    <!-- Parent Modals -->
    <% if (user && user.role === "parent") { %>
      <%
        const addStudentForm = include(
          "../partials/modalForms/addStudent"
        ); %>

      <%- include("../partials/modal", {
          modalId: "addStudentModal",
          modalTitle: "Add Student",
          body: addStudentForm
      }) %>
    <% } %>


    <!-- Bootstrap JS -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <script 
      src="https://kit.fontawesome.com/70a7a34e40.js" crossorigin="anonymous">
    </script>

    <script src="/js/authScripts.js"></script>
    <script src="/js/teacherScripts.js" ></script>
    <script src="/js/parentScript.js" ></script>

  </body>  
</html>