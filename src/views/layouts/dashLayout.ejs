<!--
  This is the dashboard layout template for the HOOT application. 
  It includes the HTML structure, Bootstrap CSS/JS, and a navigation bar. 
  The content of each page will be injected into the <main> tag using EJS templating.
-->

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title || "HOOT" %></title>

    <!-- Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link 
      rel="stylesheet" 
      href="/css/style.css" 
    />
  </head>

  <body class="bg-light">

    <!-- Navigation Bar -->
    <nav class="navbar navbar-dark bg-dark">
      <div class="container">
        <a class="navbar-brand d-flex align-items-center fw-bold" href="/">
          <img src="/images/HOOT-Logo.png" alt="HOOT logo" class="hoot-navbar-logo">
        </a>
        <div class="ms-auto d-flex gap-2">
          <a class="btn btn-outline-light btn-sm" id="logoutBtn" href="/login">Logout</a>
        </div>
      </div>
    </nav>

    <!-- Page Content Injected Here -->
    <main class="container py-5">
      <%- body %>
    </main>

    <!-- Bootstrap JS -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    ></script>

    <script src="/js/scripts.js"></script>

  </body>
</html>