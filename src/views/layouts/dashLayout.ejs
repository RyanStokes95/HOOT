<!--
  This is the dashboard layout template for the HOOT application. 
  It includes the HTML structure, Bootstrap CSS/JS, and a navigation bar. 
  The content of each page will be injected into the <main> tag using EJS templating.
-->

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title || "HOOT" %></title>

    <!-- Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link 
      rel="stylesheet" 
      href="/css/style.css" 
    />
  </head>

  <body class="bg-light">

    <!-- Navigation Bar Partial Injected Here-->
    <%- include ("../partials/dashNavbar") %>

    <!-- Page Content Injected Here -->
    <%- body %>

    <!-- Modals -->
    <%
      const addSubjectForm = include(
        "../partials/modalForms/addSubject"
    ); %>

    <%- include("../partials/modal", {
        modalId: "addSubjectModal",
        modalTitle: "Add Subject",
        body: addSubjectForm
    }) %>

    <%
      const addClassForm = include(
        "../partials/modalForms/addClass"
    ); %>

    <%- include("../partials/modal", {
        modalId: "addClassModal",
        modalTitle: "Add Class",
        body: addClassForm
    }) %>

    <%
      const editSubjectForm = include(
        "../partials/modalForms/editSubject"
    ); %>

    <%- include("../partials/modal", {
        modalId: "editSubjectModal",
        modalTitle: "Edit Subject",
        body: editSubjectForm
    }) %>

    <%
      const addTaskForm = include(
        "../partials/modalForms/addTask"
      ); %>

    <%- include("../partials/modal", {
        modalId: "addTaskModal",
        modalTitle: "Add Task",
        body: addTaskForm
    }) %>

    <%
      const addHomeworkForm = include(
        "../partials/modalForms/addHomework"
      ); %>

    <%- include("../partials/modal", {
        modalId: "addHomeworkModal",
        modalTitle: "Add Homework",
        body: addHomeworkForm
    }) %>

     <!-- Additional modals for delete subject, approve student, delete student can be added similarly -->
    

    <!-- Bootstrap JS -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    ></script>

    <script src="/js/authScripts.js"></script>
    <script src="/js/teacherScripts.js" ></script>
    <script src="/js/parentScript.js" ></script>

  </body>  
</html>