<!--
  This is the main layout template for the HOOT application. 
  It includes the HTML structure, Bootstrap CSS/JS, and a navigation bar. 
  The content of each page will be injected into the <main> tag using EJS templating.

    Note: CSS loaded after Bootstrap to allow for custom overrides.
-->

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title || "HOOT" %></title>

    <!-- Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link 
      rel="stylesheet" 
      href="/css/style.css" 
    />
  </head>

  <body class="bg-light">

    <!-- Navigation Bar -->
    <nav class="navbar navbar-dark">
      <div class="container">
        <a class="navbar-brand fw-bold" href="/">HOOT</a>

        <div class="ms-auto d-flex gap-2">
          <a class="btn btn-outline-light btn-sm" href="/login">Login</a>
          <a class="btn btn-outline-light btn-sm" href="/registerTeacher">Teacher Sign Up</a>
          <a class="btn btn-outline-light btn-sm" href="/registerParent">Parent Sign Up</a>
        </div>
      </div>
    </nav>

    <!-- Page Content Injected Here -->
    <main class="container py-5">
      <%- body %>
    </main>

    <!-- Bootstrap JS -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    ></script>

    <script src="/js/scripts.js"></script>

  </body>
</html>