<!-- mainLayout.ejs -->

<!--
  This is the main layout template for the HOOT application. 
  It includes the HTML structure, Bootstrap CSS/JS, and a navigation bar. 
  The content of each page will be injected into the <main> tag using EJS templating.

    Note: CSS loaded after Bootstrap to allow for custom overrides.
-->

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title || "HOOT" %></title>

    <!-- Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link 
      rel="stylesheet" 
      href="/css/style.css" 
    />
  </head>

  <body id="formBody" class="bg-light">

    <%- include ("../partials/mainNavbar") %>

    <!-- Page Content Injected Here -->
    <main>
      <%- body %>
    </main>

    <!-- Bootstrap JS -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    ></script>

    <script src="/js/authScripts.js"></script>
    <script src="/js/teacherScripts.js"></script>
    <script src="/js/parentScript.js"></script>

  </body>
</html>