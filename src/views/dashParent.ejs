<div class="p-5 bg-white rounded-4 shadow-sm border mb-4">
  <h1 class="display-6 fw-bold">Welcome to the Parent Dashboard</h1>
  <p class="text-muted mt-3 mb-0">
    Here you will find information and tools related to your child's education.
  </p>
</div>

<!-- Performance -->
<div class="bg-white rounded-4 shadow-sm border p-4 mb-4">
  <h4 class="fw-bold mb-3">Performance</h4>

  <div class="d-flex overflow-auto gap-3 pb-2">

    <!-- Week Card -->
    <div class="card flex-shrink-0" style="min-width: 250px;">
      <div class="card-body">
        <h6 class="fw-bold">Week 1</h6>
        <p class="text-muted mb-2">Overall: 85%</p>
        <span class="badge bg-success">Good</span>
      </div>
    </div>

    <div class="card flex-shrink-0" style="min-width: 250px;">
      <div class="card-body">
        <h6 class="fw-bold">Week 2</h6>
        <p class="text-muted mb-2">Overall: 78%</p>
        <span class="badge bg-warning text-dark">Average</span>
      </div>
    </div>

    <div class="card flex-shrink-0" style="min-width: 250px;">
      <div class="card-body">
        <h6 class="fw-bold">Week 3</h6>
        <p class="text-muted mb-2">Overall: 92%</p>
        <span class="badge bg-success">Excellent</span>
      </div>
    </div>

    <div class="card flex-shrink-0" style="min-width: 250px;">
      <div class="card-body">
        <h6 class="fw-bold">Week 4</h6>
        <p class="text-muted mb-2">Overall: 70%</p>
        <span class="badge bg-danger">Needs Attention</span>
      </div>
    </div>

  </div>
</div>

<!-- Tasks -->
<div class="bg-white rounded-4 shadow-sm border p-4 mb-4">
  <h4 class="fw-bold">Tasks</h4>
  <p class="text-muted">Check outstanding tasks, forms, permissions, and parent actions.</p>
  <a href="#" class="btn btn-primary btn-sm">View Tasks</a>
</div>

<!-- Homework -->
<div class="bg-white rounded-4 shadow-sm border p-4 mb-4">
  <h4 class="fw-bold">Homework Journal</h4>
  <p class="text-muted">Keep track of assigned homework.</p>
  <a href="#" class="btn btn-primary btn-sm">View Homework</a>
</div>

<!-- Bulletin -->
<div class="bg-white rounded-4 shadow-sm border p-4 mb-4">
  <h4 class="fw-bold">Bulletin</h4>
  <p class="text-muted">Read classroom updates, announcements and teacher messages.</p>
  <a href="#" class="btn btn-primary btn-sm">View Bulletin</a>
</div>