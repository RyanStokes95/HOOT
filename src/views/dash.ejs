<!-- dash.ejs -->
 
<!-- Main Content -->
<main class="container py-5">

    <% if (user && user.role === "teacher") { %>

        <% if (teacherClass) { %>

            <%- include("./partials/dashTeacher") %>

        <% } else { %>

            <%- include("./partials/noClassTeacher") %>

        <% } %>

    <% } else if (user && user.role === "parent") { %>

        <% if (classDashboards && classDashboards.length > 0) { %>

            <%- include("./partials/dashParent") %>

        <% } else { %>

            <%- include("./partials/noClassParent") %>

        <% } %>

    <% } %>

</main>