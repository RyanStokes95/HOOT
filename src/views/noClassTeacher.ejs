<!-- Main Content -->

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="bg-white rounded-4 shadow-sm border p-5 text-center">

                <div class="mb-4">
                    <i class="bi bi-journal-x display-1 text-secondary"></i>
                </div>

                <h1 class="fw-bold mb-3">
                    No Class Linked
                </h1>

                <p class="text-muted fs-5 mb-4">
                    You currently do not have a class assigned to your account.
                    Create a new class to begin managing students, homework,
                    tasks, and bulletin updates.
                </p>

                <div class="d-flex justify-content-center gap-3 flex-wrap">

                    <a href="/teacher/classes/create"
                       class="btn btn-primary btn-lg px-4 rounded-3">
                        Create Class
                    </a>

                    <a id="logoutBtn" href="/login"
                       class="btn btn-outline-secondary btn-lg px-4 rounded-3">
                        Logout
                    </a>

                </div>

            </div>

            <div class="bg-light border rounded-4 p-4 mt-4">

                <h5 class="fw-bold mb-3">
                    What you can do with a class
                </h5>

                <div class="row g-3">

                    <div class="col-md-6">
                        <div class="border rounded-3 p-3 h-100 bg-white">
                            <h6 class="fw-bold">Manage Students</h6>
                            <p class="text-muted mb-0">
                                Add and organise students within your classroom.
                            </p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="border rounded-3 p-3 h-100 bg-white">
                            <h6 class="fw-bold">Assign Homework</h6>
                            <p class="text-muted mb-0">
                                Upload and track homework tasks for students.
                            </p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="border rounded-3 p-3 h-100 bg-white">
                            <h6 class="fw-bold">Post Bulletins</h6>
                            <p class="text-muted mb-0">
                                Share updates and announcements with parents.
                            </p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="border rounded-3 p-3 h-100 bg-white">
                            <h6 class="fw-bold">Track Performance</h6>
                            <p class="text-muted mb-0">
                                Monitor student progress and weekly reports.
                            </p>
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>