<!-- Author: Ryan Stokes -->
<!-- dashParent.ejs -->
 
<div class="bg-white border rounded-3 shadow-sm p-4 mb-4">

    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">

        <div>

            <span class="badge rounded-pill text-bg-light border mb-2">
                Parent Dashboard
            </span>

            <h5 class="fw-semibold mb-2">
                <%= user.name %>
            </h5>

            <p class="text-muted small mb-0">
                View homework, tasks, bulletins and your children's progress.
            </p>

        </div>

        <% if (classDashboards.length && classDashboards[0].currentWeek) { %>

            <div class="d-flex align-items-center gap-3">

                <a class="week-nav-btn"
                   href="?weekOffset=<%= (weekOffset || 0) - 1 %>">
                    <i class="fa-solid fa-chevron-left"></i>
                </a>

                <div class="text-center px-2">

                    <div class="text-muted small mb-1">
                        Selected Week
                    </div>

                    <div class="fw-semibold">
                        <%= classDashboards[0].currentWeek.weekStartDate.toDateString() %>
                    </div>

                    <small class="text-muted">
                        <%= classDashboards[0].currentWeek.weekEndDate.toDateString() %>
                    </small>

                </div>

                <a class="week-nav-btn"
                   href="?weekOffset=<%= (weekOffset || 0) + 1 %>">
                    <i class="fa-solid fa-chevron-right"></i>
                </a>

            </div>

        <% } %>

    </div>

    <hr class="my-4">

    <div class="d-flex flex-wrap align-items-center gap-2">

        <% classDashboards.forEach((dashboard, classIndex) => { %>

            <button
                type="button"
                class="btn btn-outline-primary btn-sm rounded-pill px-3 <%= classIndex === 0 ? 'active' : '' %>"
                id="class-tab-<%= dashboard.parentClass._id %>"
                data-bs-toggle="tab"
                data-bs-target="#class-dashboard-<%= dashboard.parentClass._id %>"
                role="tab"
                aria-controls="class-dashboard-<%= dashboard.parentClass._id %>"
                aria-selected="<%= classIndex === 0 ? 'true' : 'false' %>">

                <%= dashboard.parentClass.name %>

            </button>

        <% }) %>

        <button
            type="button"
            class="btn btn-primary btn-sm rounded-pill px-3"
            data-bs-toggle="modal"
            data-bs-target="#addStudentModal">

            <i class="fa-solid fa-plus me-2"></i>
            Join Class

        </button>

    </div>

</div>

    <div class="tab-content">

        <% classDashboards.forEach((dashboard, classIndex) => { %>

            <div
                class="tab-pane fade <%= classIndex === 0 ? 'show active' : '' %>"
                id="class-dashboard-<%= dashboard.parentClass._id %>"
                role="tabpanel"
                aria-labelledby="class-tab-<%= dashboard.parentClass._id %>">

                <% if (dashboard.parentStudents && dashboard.parentStudents.length > 0) { %>

                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h5 class="fw-bold mb-1">Student Feedback</h5>

                                <p class="text-muted mb-0">
                                    Switch between children to view individual feedback.
                                </p>
                            </div>
                        </div>

                        <div class="nav d-inline-flex flex-wrap gap-2 mb-4" role="tablist">

                            <% dashboard.parentStudents.forEach((student, studentIndex) => { %>

                                <button
                                    type="button"
                                    class="btn btn-outline-secondary btn-sm rounded-pill px-3 <%= studentIndex === 0 ? 'active' : '' %>"
                                    id="student-tab-<%= dashboard.parentClass._id %>-<%= student._id %>"
                                    data-bs-toggle="tab"
                                    data-bs-target="#student-feedback-<%= dashboard.parentClass._id %>-<%= student._id %>"
                                    role="tab"
                                    aria-controls="student-feedback-<%= dashboard.parentClass._id %>-<%= student._id %>"
                                    aria-selected="<%= studentIndex === 0 ? 'true' : 'false' %>">

                                    <%= student.name %>

                                </button>

                            <% }) %>

                        </div>

                        <div class="tab-content">

                            <% dashboard.parentStudents.forEach((student, studentIndex) => { %>

                                <div
                                    class="tab-pane fade <%= studentIndex === 0 ? 'show active' : '' %>"
                                    id="student-feedback-<%= dashboard.parentClass._id %>-<%= student._id %>"
                                    role="tabpanel"
                                    aria-labelledby="student-tab-<%= dashboard.parentClass._id %>-<%= student._id %>">

                                    <div class="border rounded-4 p-4 mb-4">
                                        <h5 class="fw-bold mb-1">
                                            <%= student.name %>'s Weekly Feedback
                                        </h5>

                                        <p class="text-muted mb-0">
                                            Subject progress for the current week.
                                        </p>
                                    </div>

                                    <%
                                        const studentFeedback = dashboard.currentWeek.weeklyFeedback.filter(item => {
                                            return item.student.toString() === student._id.toString();
                                        });
                                    %>

                                    <% if (studentFeedback.length > 0) { %>

                                        <div class="row g-3">

                                            <% studentFeedback.forEach(item => { %>

                                                <div class="col-md-6 col-lg-4">
                                                    <div class="bg-white border rounded-4 p-3 h-100 shadow-sm">

                                                        <%
                                                          const subject = dashboard.parentClass.subjects.find(classSubject => {
                                                              return classSubject._id.toString() === item.subject.toString();
                                                          });
                                                        %>

                                                        <h6 class="fw-bold mb-2">
                                                            <%= subject ? subject.name : "Unknown Subject" %>
                                                        </h6>

                                                        <% if (item.feedback === "Exceeding Expectations") { %>

                                                            <span class="badge bg-success rounded-pill">
                                                                <%= item.feedback %>
                                                            </span>

                                                        <% } else if (item.feedback === "On Track") { %>

                                                            <span class="badge bg-warning text-dark rounded-pill">
                                                                <%= item.feedback %>
                                                            </span>

                                                        <% } else { %>

                                                            <span class="badge bg-danger rounded-pill">
                                                                <%= item.feedback %>
                                                            </span>

                                                        <% } %>

                                                    </div>
                                                </div>

                                            <% }) %>

                                        </div>

                                    <% } else { %>

                                        <div class="bg-white border rounded-4 p-4">
                                            <p class="text-muted mb-0">
                                                No feedback has been added for <%= student.name %> this week yet.
                                            </p>
                                        </div>

                                    <% } %>

                                </div>

                            <% }) %>

                        </div>
                    </div>

                <% } else { %>

                    <div class="bg-white border rounded-4 p-4 mb-4">
                        <p class="text-muted mb-0">
                            No active children linked to this class.
                        </p>
                    </div>

                <% } %>

                <div class="row g-4">

                    <div class="col-lg-6">

                        <div class="card border-0 shadow-sm h-100">

                            <div class="card-body">

                                <div class="d-flex justify-content-between align-items-center mb-4">

                                    <div>

                                        <h5 class="fw-bold mb-0">
                                            Homework
                                        </h5>

                                        <small class="text-muted">
                                            Homework assigned this week
                                        </small>

                                    </div>

                                    <i class="fa-solid fa-book-open fa-2x text-success"></i>

                                </div>

                                <% if (dashboard.currentWeek.dailyHomework && dashboard.currentWeek.dailyHomework.length > 0) { %>

                                    <% dashboard.currentWeek.dailyHomework.forEach(homework => { %>

                                        <div class="card border shadow-sm mb-3">

                                            <div class="card-body">

                                                <% if (homework.subject && homework.subject.name) { %>

                                                    <span class="badge bg-primary mb-2">
                                                        <%= homework.subject.name %>
                                                    </span>

                                                <% } %>

                                                <h5 class="fw-bold mb-2">
                                                    <%= homework.title %>
                                                </h5>

                                                <p class="text-muted mb-3">
                                                    <%= homework.description %>
                                                </p>

                                                <small class="text-muted d-block mb-1">
                                                    <i class="fa-regular fa-calendar me-2"></i>
                                                    <strong>Assigned:</strong> <%= homework.day %>
                                                </small>

                                                <small class="text-muted">

                                                    <i class="fa-solid fa-hourglass-end me-2"></i>

                                                    <strong>Due Date:</strong>

                                                    <% if (homework.dueDate) { %>

                                                        <%= new Date(homework.dueDate).toLocaleDateString("en-IE", {
                                                            weekday: "long",
                                                            day: "numeric",
                                                            month: "long",
                                                            year: "numeric"
                                                        }) %>

                                                    <% } else { %>

                                                        No due date

                                                    <% } %>

                                                </small>

                                            </div>

                                        </div>

                                    <% }) %>

                                <% } else { %>

                                    <div class="text-center py-5">

                                        <i class="fa-solid fa-book-open fa-3x text-muted mb-3"></i>

                                        <h6 class="fw-semibold">
                                            No homework assigned
                                        </h6>

                                        <p class="text-muted mb-0">
                                            Homework assigned by your teacher will appear here.
                                        </p>

                                    </div>

                                <% } %>

                            </div>

                        </div>

                    </div>

                   <div class="col-lg-6">

                        <div class="card border-0 shadow-sm h-100">

                            <div class="card-body">

                                <div class="d-flex justify-content-between align-items-center mb-4">

                                    <div>

                                        <h5 class="fw-bold mb-0">
                                            Tasks
                                        </h5>

                                        <small class="text-muted">
                                            Tasks assigned by your teacher
                                        </small>

                                    </div>

                                    <i class="fa-solid fa-list-check fa-2x" style="color:#0d6efd;"></i>

                                </div>

                                <% if (dashboard.parentTasks && dashboard.parentTasks.length > 0) { %>

                                    <% dashboard.parentTasks.forEach(task => { %>

                                        <div class="card border shadow-sm mb-3">

                                            <div class="card-body">

                                                <span class="badge bg-secondary mb-2">
                                                    Task
                                                </span>

                                                <h5 class="fw-bold mb-2">
                                                    <%= task.title %>
                                                </h5>

                                                <p class="text-muted mb-3">
                                                    <%= task.description || "No description provided." %>
                                                </p>

                                                <small class="text-muted">

                                                    <i class="fa-regular fa-calendar me-2"></i>

                                                    <strong>Due Date:</strong>

                                                    <% if (task.dueDate) { %>

                                                        <%= new Date(task.dueDate).toLocaleDateString("en-IE", {
                                                            weekday: "long",
                                                            day: "numeric",
                                                            month: "long",
                                                            year: "numeric"
                                                        }) %>

                                                    <% } else { %>

                                                        No due date

                                                    <% } %>

                                                </small>

                                            </div>

                                        </div>

                                    <% }) %>

                                <% } else { %>

                                    <div class="text-center py-5">

                                        <i class="fa-solid fa-list-check fa-3x text-muted mb-3"></i>

                                        <h6 class="fw-semibold">
                                            No tasks assigned
                                        </h6>

                                        <p class="text-muted mb-0">
                                            Tasks assigned by your teacher will appear here.
                                        </p>

                                    </div>

                                <% } %>

                            </div>

                        </div>

                    </div>

                <div class="card border-0 shadow-sm mt-4">

    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>

                <h5 class="fw-bold mb-0">
                    Bulletins
                </h5>

                <small class="text-muted">
                    Latest announcements from your teacher
                </small>

            </div>

            <i class="fa-solid fa-bullhorn fa-2x text-warning"></i>

        </div>

        <% if (dashboard.parentClass.bulletins && dashboard.parentClass.bulletins.length > 0) { %>

            <% dashboard.parentClass.bulletins.forEach(bulletin => { %>

                <div class="card border shadow-sm mb-3">

                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-start mb-2">

                            <span class="badge bg-warning text-dark">
                                <i class="fa-solid fa-bullhorn me-1"></i>
                                Bulletin
                            </span>

                            <small class="text-muted">
                                <i class="fa-regular fa-clock me-1"></i>

                                <%= new Date(bulletin.createdAt).toLocaleDateString("en-IE", {
                                    day: "numeric",
                                    month: "long",
                                    year: "numeric"
                                }) %>
                            </small>

                        </div>

                        <h5 class="fw-bold mb-2">
                            <%= bulletin.title %>
                        </h5>

                        <p class="text-muted mb-0">
                            <%= bulletin.content %>
                        </p>

                    </div>

                </div>

            <% }) %>

        <% } else { %>

            <div class="text-center py-5">

                <i class="fa-solid fa-bullhorn fa-3x text-muted mb-3"></i>

                <h6 class="fw-semibold">
                    No bulletins available
                </h6>

                <p class="text-muted mb-0">
                    Classroom announcements will appear here.
                </p>

            </div>

        <% } %>

    </div>

</div>

            </div>

        <% }) %>

    </div>

</div>