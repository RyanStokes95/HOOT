<div class="bg-white rounded-4 shadow-sm border p-4 mb-4">

    <div class="mb-4">
        <h4 class="fw-bold mb-2">Classes</h4>

        <div class="nav d-inline-flex flex-wrap gap-2" role="tablist">

            <% classDashboards.forEach((dashboard, classIndex) => { %>

                <button
                    type="button"
                    class="btn btn-outline-primary btn-sm rounded-pill px-3 <%= classIndex === 0 ? 'active' : '' %>"
                    id="class-tab-<%= dashboard.parentClass._id %>"
                    data-bs-toggle="tab"
                    data-bs-target="#class-dashboard-<%= dashboard.parentClass._id %>"
                    role="tab"
                    aria-controls="class-dashboard-<%= dashboard.parentClass._id %>"
                    aria-selected="<%= classIndex === 0 ? 'true' : 'false' %>">

                    <%= dashboard.parentClass.name %>

                </button>

            <% }) %>

            <button
              type="button"
              class="btn btn-primary rounded-pill px-4"
              data-bs-toggle="modal"
              data-bs-target="#addStudentModal">

              <i class="fa-solid fa-plus me-2"></i>
              Join Class

          </button>

        </div>
    </div>


    <div class="tab-content">

        <% classDashboards.forEach((dashboard, classIndex) => { %>

            <div
                class="tab-pane fade <%= classIndex === 0 ? 'show active' : '' %>"
                id="class-dashboard-<%= dashboard.parentClass._id %>"
                role="tabpanel"
                aria-labelledby="class-tab-<%= dashboard.parentClass._id %>">

                <% if (dashboard.parentStudents && dashboard.parentStudents.length > 0) { %>

                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h5 class="fw-bold mb-1">Student Feedback</h5>

                                <p class="text-muted mb-0">
                                    Switch between children to view individual feedback.
                                </p>
                            </div>
                        </div>

                        <div class="nav d-inline-flex flex-wrap gap-2 mb-4" role="tablist">

                            <% dashboard.parentStudents.forEach((student, studentIndex) => { %>

                                <button
                                    type="button"
                                    class="btn btn-outline-secondary btn-sm rounded-pill px-3 <%= studentIndex === 0 ? 'active' : '' %>"
                                    id="student-tab-<%= dashboard.parentClass._id %>-<%= student._id %>"
                                    data-bs-toggle="tab"
                                    data-bs-target="#student-feedback-<%= dashboard.parentClass._id %>-<%= student._id %>"
                                    role="tab"
                                    aria-controls="student-feedback-<%= dashboard.parentClass._id %>-<%= student._id %>"
                                    aria-selected="<%= studentIndex === 0 ? 'true' : 'false' %>">

                                    <%= student.name %>

                                </button>

                            <% }) %>

                        </div>

                        <div class="tab-content">

                            <% dashboard.parentStudents.forEach((student, studentIndex) => { %>

                                <div
                                    class="tab-pane fade <%= studentIndex === 0 ? 'show active' : '' %>"
                                    id="student-feedback-<%= dashboard.parentClass._id %>-<%= student._id %>"
                                    role="tabpanel"
                                    aria-labelledby="student-tab-<%= dashboard.parentClass._id %>-<%= student._id %>">

                                    <div class="border rounded-4 p-4 mb-4">
                                        <h5 class="fw-bold mb-1">
                                            <%= student.name %>'s Weekly Feedback
                                        </h5>

                                        <p class="text-muted mb-0">
                                            Subject progress for the current week.
                                        </p>
                                    </div>

                                    <%
                                        const studentFeedback = dashboard.currentWeek.weeklyFeedback.filter(item => {
                                            return item.student.toString() === student._id.toString();
                                        });
                                    %>

                                    <% if (studentFeedback.length > 0) { %>

                                        <div class="row g-3">

                                            <% studentFeedback.forEach(item => { %>

                                                <div class="col-md-6 col-lg-4">
                                                    <div class="bg-white border rounded-4 p-3 h-100 shadow-sm">

                                                        <%
                                                          const subject = dashboard.parentClass.subjects.find(classSubject => {
                                                              return classSubject._id.toString() === item.subject.toString();
                                                          });
                                                        %>

                                                        <h6 class="fw-bold mb-2">
                                                            <%= subject ? subject.name : "Unknown Subject" %>
                                                        </h6>

                                                        <% if (item.feedback === "Exceeding Expectations") { %>

                                                            <span class="badge bg-success rounded-pill">
                                                                <%= item.feedback %>
                                                            </span>

                                                        <% } else if (item.feedback === "On Track") { %>

                                                            <span class="badge bg-warning text-dark rounded-pill">
                                                                <%= item.feedback %>
                                                            </span>

                                                        <% } else { %>

                                                            <span class="badge bg-danger rounded-pill">
                                                                <%= item.feedback %>
                                                            </span>

                                                        <% } %>

                                                    </div>
                                                </div>

                                            <% }) %>

                                        </div>

                                    <% } else { %>

                                        <div class="bg-white border rounded-4 p-4">
                                            <p class="text-muted mb-0">
                                                No feedback has been added for <%= student.name %> this week yet.
                                            </p>
                                        </div>

                                    <% } %>

                                </div>

                            <% }) %>

                        </div>
                    </div>

                <% } else { %>

                    <div class="bg-white border rounded-4 p-4 mb-4">
                        <p class="text-muted mb-0">
                            No active children linked to this class.
                        </p>
                    </div>

                <% } %>

                <div class="row g-4">

                    <div class="col-lg-6">
                        <div class="bg-white rounded-4 shadow-sm border p-4 h-100">
                            <h5 class="fw-bold mb-3">Homework Journal</h5>

                            <% if (dashboard.currentWeek.dailyHomework && dashboard.currentWeek.dailyHomework.length > 0) { %>

                                <% dashboard.currentWeek.dailyHomework.forEach(homework => { %>

                                    <div class="border rounded-4 p-3 mb-3">
                                        <div class="d-flex justify-content-between align-items-start gap-3">

                                            <div>
                                                <h6 class="fw-bold mb-1">
                                                    <%= homework.title %>
                                                </h6>

                                                <p class="text-muted mb-1">
                                                    <%= homework.description %>
                                                </p>

                                                <% if (homework.subject && homework.subject.name) { %>

                                                    <small class="text-muted">
                                                        <i class="fa-solid fa-book me-1"></i>
                                                        <%= homework.subject.name %>
                                                    </small>

                                                <% } %>

                                            </div>

                                            <span class="badge bg-light text-dark border">
                                                <%= homework.day %>
                                            </span>

                                        </div>
                                    </div>

                                <% }) %>

                            <% } else { %>

                                <p class="text-muted mb-0">
                                    No homework has been added this week.
                                </p>

                            <% } %>

                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="bg-white rounded-4 shadow-sm border p-4 h-100">
                            <h5 class="fw-bold mb-3">Tasks</h5>

                            <% if (dashboard.parentTasks && dashboard.parentTasks.length > 0) { %>

                                <% dashboard.parentTasks.forEach(task => { %>

                                    <div class="border rounded-4 p-3 mb-3">
                                        <h6 class="fw-bold mb-1">
                                            <%= task.title %>
                                        </h6>

                                        <p class="text-muted mb-0">
                                            <%= task.description %>
                                        </p>
                                    </div>

                                <% }) %>

                            <% } else { %>

                                <p class="text-muted mb-0">
                                    No tasks assigned.
                                </p>

                            <% } %>

                        </div>
                    </div>

                </div>

                <div class="bg-white rounded-4 shadow-sm border p-4 mt-4">
                    <h5 class="fw-bold mb-3">Bulletin</h5>

                    <% if (dashboard.parentClass.bulletins && dashboard.parentClass.bulletins.length > 0) { %>

                        <div class="row g-3">

                            <% dashboard.parentClass.bulletins.forEach(bulletin => { %>

                                <div class="col-md-6">
                                    <div class="border rounded-4 p-3 h-100">

                                        <h6 class="fw-bold mb-1">
                                            <i class="fa-solid fa-bullhorn text-warning me-2"></i>
                                            <%= bulletin.title %>
                                        </h6>

                                        <p class="text-muted mb-0">
                                            <%= bulletin.content %>
                                        </p>

                                    </div>
                                </div>

                            <% }) %>

                        </div>

                    <% } else { %>

                        <p class="text-muted mb-0">
                            No classroom updates yet.
                        </p>

                    <% } %>

                </div>

            </div>

        <% }) %>

    </div>

</div>