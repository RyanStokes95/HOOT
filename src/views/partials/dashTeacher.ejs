<!-- Author: Ryan Stokes -->
<!-- dashTeacher.ejs -->

<div class="bg-white border rounded-3 shadow-sm p-4 mb-4">

    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">

        <div>
            <span class="badge rounded-pill text-bg-light border mb-2">
                Teacher Dashboard
            </span>

            <h5 class="fw-semibold mb-2">
                <%= user.name %>
            </h5>

            <p class="text-muted small mb-0">
                Manage students, homework, feedback and classroom activity.
            </p>
        </div>

        <% if (currentWeek) { %>
        <div class="d-flex align-items-center gap-3">

            <a class="week-nav-btn" href="?weekOffset=<%= (weekOffset || 0) - 1 %>">
                <i class="fa-solid fa-chevron-left"></i>
            </a>

            <div class="text-center px-2">
                <div class="text-muted small mb-1">Selected Week</div>

                <div class="fw-semibold">
                    <%= currentWeek.weekStartDate.toDateString() %>
                </div>

                <small class="text-muted">
                    <%= currentWeek.weekEndDate.toDateString() %>
                </small>
            </div>

            <a class="week-nav-btn" href="?weekOffset=<%= (weekOffset || 0) + 1 %>">
                <i class="fa-solid fa-chevron-right"></i>
            </a>

        </div>
        <% } %>

    </div>
</div>

<div class="bg-white border rounded-3 p-3 mb-4 shadow-sm">

    <div class="row text-center g-0">

        <div class="col-md-4 py-2">
            <small class="text-muted text-uppercase d-block mb-1">Class</small>
            <div class="fw-semibold"><%= teacherClass.name %></div>
        </div>

        <div class="col-md-4 py-2 border-start border-end">
            <small class="text-muted text-uppercase d-block mb-1">Students</small>
            <div class="fw-semibold"><%= teacherClass.students.length %></div>
        </div>

        <div class="col-md-4 py-2">
            <small class="text-muted text-uppercase d-block mb-1">Code</small>
            <div class="fw-semibold"><%= teacherClass.classCode %></div>
        </div>

    </div>
</div>

<div class="bg-white border rounded-4 shadow-sm p-3 mb-3">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

        <div class="fw-semibold text-muted small">
            Quick Actions
        </div>

        <div class="d-flex flex-wrap gap-2">

            <button class="btn btn-sm btn-secondary rounded-pill px-3"
                data-bs-toggle="modal"
                data-bs-target="#addTaskModal">
                + Task
            </button>

            <button class="btn btn-sm btn-success rounded-pill px-3"
                data-bs-toggle="modal"
                data-bs-target="#addHomeworkModal">
                + Homework
            </button>

            <button class="btn btn-sm btn-warning rounded-pill px-3"
                data-bs-toggle="modal"
                data-bs-target="#addBulletinModal">
                + Bulletin
            </button>

            <button class="btn btn-sm btn-primary rounded-pill px-3"
                data-bs-toggle="modal"
                data-bs-target="#addSubjectModal">
                + Subject
            </button>

        </div>

    </div>

</div>

<div class="bg-white border rounded-4 shadow-sm p-4 mb-4">

    <div class="row g-4 align-items-start">

        <div class="col-lg-7">

            <div class="fw-bold fs-5 mb-1">
                Class Management
            </div>

            <div class="text-muted small mb-3">
                Manage students, tasks, homework, bulletins and subjects
            </div>

            <ul class="nav nav-pills flex-wrap gap-2">

                <button class="nav-link rounded-pill px-3 fw-semibold active"
                    data-bs-toggle="tab"
                    data-bs-target="#students-tab">

                    Students
                    <span class="badge bg-primary ms-1">
                        <%= teacherClass.students.length %>
                    </span>

                </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link rounded-pill px-3 fw-semibold task-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#tasks-tab">

                        Tasks
                        <span class="badge bg-secondary ms-1">
                            <%= teacherClass.tasks ? teacherClass.tasks.length : 0 %>
                        </span>

                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link rounded-pill px-3 fw-semibold homework-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#homework-tab">

                        Homework
                        <span class="badge bg-success ms-1">
                            <%= currentWeek.dailyHomework.length %>
                        </span>

                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link rounded-pill px-3 fw-semibold bulletin-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#bulletins-tab">

                        Bulletins
                        <span class="badge bg-warning text-dark ms-1">
                            <%= teacherClass.bulletins.length %>
                        </span>

                    </button>
                </li>

                <li class="nav-item">
                    <button class="nav-link rounded-pill px-3 fw-semibold subject-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#subjects-tab">

                        Subjects
                        <span class="badge bg-info ms-1">
                            <%= teacherClass.subjects.length %>
                        </span>

                    </button>
                </li>

            </ul>

        </div>

    </div>

</div>

<div class="tab-content">

<div class="tab-pane fade show active" id="students-tab">

    <div class="bg-white rounded-4 shadow-sm border p-4 mb-4">

        <h4 class="fw-bold mb-3">Student List</h4>

        <% if (teacherClass.students.length > 0) { %>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Student Name</th>
                            <th>Parent</th>
                            <th>Status</th>
                            <th class="text-center">Feedback</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% teacherClass.students.forEach(student => { %>
                        <tr>
                            <td><%= student.name %></td>
                            <td><%= student.parent.name %></td>

                            <td>
                                <% if (student.status === "Active") { %>
                                    <span class="badge bg-success">Active</span>
                                <% } else if (student.status === "Pending") { %>
                                    <span class="badge bg-warning text-dark">Pending</span>
                                <% } else { %>
                                    <span class="badge bg-secondary">Removed</span>
                                <% } %>
                            </td>

                            <td class="text-center">
                                <%
                                    const feedbackComplete =
                                        currentWeek &&
                                        currentWeek.weeklyFeedbackCompleted &&
                                        currentWeek.weeklyFeedbackCompleted.some(entry =>
                                            entry.student.toString() === student._id.toString() &&
                                            entry.completed
                                        );
                                %>

                                <% if (feedbackComplete) { %>
                                    <i class="fa-solid fa-circle-check text-success fs-5"></i>
                                <% } else { %>
                                    <i class="fa-solid fa-circle-xmark text-danger fs-5"></i>
                                <% } %>
                            </td>

                            <td class="text-end">

                                <% if (student.status === "Pending") { %>
                                    <a
                                        href="#"
                                        class="btn btn-outline-success btn-sm me-1 approve-student-btn"
                                        data-student-id="<%= student._id %>">

                                        Approve

                                    </a>
                                <% } %>

                                <% if (student.status === "Active") { %>
                                    <%- include("../partials/modalForms/addFeedback", {
                                        student,
                                        teacherClass,
                                        weekOffset
                                    }) %>

                                    <button
                                        type="button"
                                        class="btn btn-sm me-1 add-feedback-btn"
                                        data-bs-toggle="modal"
                                        data-bs-target="#feedbackModal-<%= student._id %>">

                                        <i class="fa-regular fa-pen-to-square text-primary fs-5"></i>

                                    </button>
                                <% } %>

                                <button
                                    type="button"
                                    class="btn btn-sm delete-student-btn"
                                    data-student-id="<%= student._id %>">

                                    <i class="fa-solid fa-trash text-danger"></i>

                                </button>

                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <p class="text-muted mb-0">No students linked.</p>
        <% } %>

    </div>

</div>
<div class="tab-pane fade" id="tasks-tab">

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>
                    <h5 class="fw-bold mb-0">Tasks</h5>
                    <small class="text-muted">Manage class assignments and parent actions</small>
                </div>

                <button
                    class="btn btn-secondary"
                    data-bs-toggle="modal"
                    data-bs-target="#addTaskModal">
                    <i class="fa-solid fa-plus me-2"></i>
                    Add Task
                </button>

            </div>

            <% if (!teacherClass.tasks || teacherClass.tasks.length === 0) { %>

                <div class="text-center py-5">
                    <i class="fa-solid fa-list-check fa-3x text-muted mb-3"></i>
                    <h6 class="fw-semibold">No tasks assigned</h6>
                    <p class="text-muted mb-0">
                        Tasks created for parents will appear here.
                    </p>
                </div>

            <% } else { %>

                <% teacherClass.tasks.forEach(task => { %>

                    <div class="card border shadow-sm mb-3">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start">

                                <div class="flex-grow-1">

                                    <div class="d-flex align-items-center gap-2 mb-2">

                                        <span class="badge bg-secondary">
                                            Task
                                        </span>

                                    </div>

                                    <h5 class="fw-bold mb-2">
                                        <%= task.title %>
                                    </h5>

                                    <p class="text-muted mb-3">
                                        <%= task.description || "No description provided." %>
                                    </p>

                                    <div class="row small text-muted">

                                        <div class="col-md-6 mb-2">
                                            <i class="fa-solid fa-users me-2"></i>
                                            <strong>Assigned To:</strong><br>

                                            <% if (task.assignedTo && task.assignedTo.length) { %>
                                                <%= task.assignedTo.map(a => a.name).join(", ") %>
                                            <% } else { %>
                                                None
                                            <% } %>

                                        </div>

                                        <div class="col-md-6 mb-2">
                                            <i class="fa-regular fa-calendar me-2"></i>
                                            <strong>Due Date:</strong><br>

                                            <% if (task.dueDate) { %>
                                                <%= new Date(task.dueDate).toLocaleDateString("en-IE", {
                                                    weekday: "long",
                                                    day: "numeric",
                                                    month: "long",
                                                    year: "numeric"
                                                }) %>
                                            <% } else { %>
                                                No due date
                                            <% } %>

                                        </div>

                                    </div>

                                </div>

                                <div class="ms-3 text-end">

                                    <button
                                        type="button"
                                        class="btn btn-light btn-sm border edit-task-btn mb-2"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editTaskModal"
                                        data-task-id="<%= task._id %>"
                                        data-task-title="<%= task.title %>"
                                        data-task-description="<%= task.description %>"
                                        data-task-duedate="<%= task.dueDate ? new Date(task.dueDate).toISOString().split('T')[0] : '' %>"
                                    >
                                        <i class="fa-solid fa-pen"></i>
                                    </button>

                                    <button
                                        class="btn btn-light btn-sm border delete-task-btn"
                                        data-task-id="<%= task._id %>"
                                    >
                                        <i class="fa-solid fa-trash text-danger"></i>
                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>

                <% }) %>

            <% } %>

        </div>
    </div>

</div>

<div class="tab-pane fade" id="homework-tab">

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>
                    <h5 class="fw-bold mb-0">Homework</h5>
                    <small class="text-muted">Manage homework assigned to your class</small>
                </div>

                <button
                    class="btn btn-success"
                    data-bs-toggle="modal"
                    data-bs-target="#addHomeworkModal">
                    <i class="fa-solid fa-plus me-2"></i>
                    Add Homework
                </button>

            </div>

            <% if (currentWeek.dailyHomework.length === 0) { %>

                <div class="text-center py-5">
                    <i class="fa-solid fa-book-open fa-3x text-muted mb-3"></i>
                    <h6 class="fw-semibold">No homework assigned</h6>
                    <p class="text-muted mb-0">
                        Homework added this week will appear here.
                    </p>
                </div>

            <% } else { %>

                <% currentWeek.dailyHomework.forEach(hw => { %>

                    <div class="card border mb-3 shadow-sm">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start">

                                <div class="flex-grow-1">

                                    <div class="d-flex align-items-center gap-2 mb-2">

                                        <span class="badge bg-primary">
                                            <%= hw.subjectName %>
                                        </span>

                                        <span class="badge bg-light text-dark border">
                                            <%= hw.day %>
                                        </span>

                                    </div>

                                    <h5 class="fw-bold mb-2">
                                        <%= hw.title %>
                                    </h5>

                                    <p class="text-muted mb-3">
                                        <%= hw.description %>
                                    </p>

                                    <div class="row small text-muted">

                                        <div class="col-md-6 mb-2">
                                            <i class="fa-regular fa-calendar me-2"></i>
                                            <strong>Assigned:</strong>
                                            <%= hw.day %>
                                        </div>

                                        <div class="col-md-6 mb-2">
                                            <i class="fa-solid fa-hourglass-end me-2 text-danger"></i>
                                            <strong>Due:</strong>

                                            <% if (hw.dueDate) { %>
                                                <%= new Date(hw.dueDate).toLocaleDateString("en-IE", {
                                                    weekday: "long",
                                                    day: "numeric",
                                                    month: "long",
                                                    year: "numeric"
                                                }) %>
                                            <% } else { %>
                                                No due date
                                            <% } %>
                                        </div>

                                    </div>

                                </div>

                                <div class="ms-3 text-end">

                                    <button
                                        type="button"
                                        class="btn btn-light btn-sm border edit-homework-btn mb-2"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editHomeworkModal"
                                        data-homework-id="<%= hw._id %>"
                                        data-homework-day="<%= hw.day %>"
                                        data-homework-title="<%= hw.title %>"
                                        data-homework-description="<%= hw.description %>"
                                        data-homework-subject="<%= hw.subject ? hw.subject._id : '' %>"
                                        data-homework-due-date="<%= hw.dueDate ? new Date(hw.dueDate).toISOString().split('T')[0] : '' %>"
                                    >
                                        <i class="fa-solid fa-pen"></i>
                                    </button>

                                    <button
                                        class="btn btn-light btn-sm border delete-homework-btn"
                                        data-homework-id="<%= hw._id %>"
                                    >
                                        <i class="fa-solid fa-trash text-danger"></i>
                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>

                <% }) %>

            <% } %>

        </div>
    </div>

</div>

<div class="tab-pane fade" id="bulletins-tab">

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>
                    <h5 class="fw-bold mb-0">Bulletins</h5>
                    <small class="text-muted">Share announcements and important updates with parents</small>
                </div>

                <button
                    class="btn btn-warning"
                    data-bs-toggle="modal"
                    data-bs-target="#addBulletinModal">
                    <i class="fa-solid fa-plus me-2"></i>
                    Add Bulletin
                </button>

            </div>

            <% if (teacherClass.bulletins.length === 0) { %>

                <div class="text-center py-5">
                    <i class="fa-solid fa-bullhorn fa-3x text-muted mb-3"></i>
                    <h6 class="fw-semibold">No bulletins published</h6>
                    <p class="text-muted mb-0">
                        School and class announcements will appear here.
                    </p>
                </div>

            <% } else { %>

                <% teacherClass.bulletins.forEach(bulletin => { %>

                    <div class="card border shadow-sm mb-3">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start">

                                <div class="flex-grow-1">

                                    <div class="d-flex align-items-center gap-2 mb-2">

                                        <span class="badge bg-warning text-dark">
                                            <i class="fa-solid fa-bullhorn me-1"></i>
                                            Bulletin
                                        </span>

                                    </div>

                                    <h5 class="fw-bold mb-2">
                                        <%= bulletin.title %>
                                    </h5>

                                    <p class="text-muted mb-3">
                                        <%= bulletin.content %>
                                    </p>

                                    <div class="row small text-muted">

                                        <div class="col-md-6 mb-2">
                                            <i class="fa-regular fa-clock me-2"></i>
                                            <strong>Posted:</strong><br>

                                            <%= new Date(bulletin.createdAt).toLocaleDateString("en-IE", {
                                                weekday: "long",
                                                day: "numeric",
                                                month: "long",
                                                year: "numeric"
                                            }) %>
                                        </div>

                                        <div class="col-md-6 mb-2">
                                            <i class="fa-regular fa-calendar-plus me-2"></i>
                                            <strong>Published:</strong><br>

                                            <%= new Date(bulletin.createdAt).toLocaleTimeString("en-IE", {
                                                hour: "2-digit",
                                                minute: "2-digit"
                                            }) %>
                                        </div>

                                    </div>

                                </div>

                                <div class="ms-3 text-end">

                                    <button
                                        type="button"
                                        class="btn btn-light btn-sm border edit-bulletin-btn mb-2"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editBulletinModal"
                                        data-bulletin-id="<%= bulletin._id %>"
                                        data-bulletin-title="<%= bulletin.title %>"
                                        data-bulletin-content="<%= bulletin.content %>"
                                    >
                                        <i class="fa-solid fa-pen"></i>
                                    </button>

                                    <button
                                        class="btn btn-light btn-sm border delete-bulletin-btn"
                                        data-bulletin-id="<%= bulletin._id %>"
                                    >
                                        <i class="fa-solid fa-trash text-danger"></i>
                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>

                <% }) %>

            <% } %>

        </div>
    </div>

</div>

<div class="tab-pane fade" id="subjects-tab">

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <div>
                    <h5 class="fw-bold mb-0">Subjects</h5>
                    <small class="text-muted">Manage the subjects taught in this class</small>
                </div>

                <button
                    type="button"
                    class="btn btn-hoot-info"
                    id="addSubject"
                    data-bs-toggle="modal"
                    data-bs-target="#addSubjectModal">
                    <i class="fa-solid fa-plus me-2"></i>
                    Add Subject
                </button>

            </div>

            <% if (teacherClass.subjects.length === 0) { %>

                <div class="text-center py-5">
                    <i class="fa-solid fa-book fa-3x text-muted mb-3"></i>
                    <h6 class="fw-semibold">No subjects added</h6>
                    <p class="text-muted mb-0">
                        Add subjects to organise homework and weekly feedback.
                    </p>
                </div>

            <% } else { %>

                <% teacherClass.subjects.forEach(subject => { %>

                    <div class="card border shadow-sm mb-3">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-center">

                                <div>

                                    <h5 class="fw-bold mb-1">
                                        <%= subject.name %>
                                    </h5>

                                </div>

                                <div class="text-end">

                                    <button
                                        type="button"
                                        class="btn btn-light btn-sm border edit-subject-btn mb-2"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editSubjectModal"
                                        data-subject-id="<%= subject._id %>"
                                        data-subject-name="<%= subject.name %>">
                                        <i class="fa-solid fa-pen"></i>
                                    </button>

                                    <button
                                        class="btn btn-light btn-sm border delete-subject-btn"
                                        data-subject-id="<%= subject._id %>">
                                        <i class="fa-solid fa-trash text-danger"></i>
                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>

                <% }) %>

            <% } %>

        </div>
    </div>

    <input type="hidden" id="weekOffset" value="<%= weekOffset || 0 %>">

</div>