<div class="bg-white border rounded-3 shadow-sm p-4 mb-4">

    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">

        <div>

            <span class="badge rounded-pill text-bg-light border mb-2">
                Teacher Dashboard
            </span>

            <h5 class="fw-semibold mb-2">
                <%= user.name %>
            </h5>

            <p class="text-muted small mb-0">
                Manage students, homework, feedback and classroom activity.
            </p>

        </div>

        <% if (currentWeek) { %>

            <div class="d-flex align-items-center gap-3">

                <button class="week-nav-btn">
                    <i class="fa-solid fa-chevron-left"></i>
                </button>

                <div class="text-center px-2">
                    <div class="text-muted small mb-1">
                        Current Week
                    </div>

                    <div class="fw-semibold">
                        <%= currentWeek.weekStartDate.toDateString() %>
                    </div>

                    <small class="text-muted">
                        <%= currentWeek.weekEndDate.toDateString() %>
                    </small>
                </div>

                <button class="week-nav-btn">
                    <i class="fa-solid fa-chevron-right"></i>
                </button>

            </div>

        <% } %>

    </div>

</div>

<div class="bg-white border rounded-3 p-3 mb-4 shadow-sm">

    <div class="row text-center g-0">

        <div class="col-md-4 py-2">
            <small class="text-muted text-uppercase d-block mb-1">
                Class
            </small>
            <div class="fw-semibold">
                <%= teacherClass.name %>
            </div>
        </div>

        <div class="col-md-4 py-2 border-start border-end">
            <small class="text-muted text-uppercase d-block mb-1">
                Students
            </small>
            <div class="fw-semibold">
                <%= teacherClass.students.length %>
            </div>
        </div>

        <div class="col-md-4 py-2">
            <small class="text-muted text-uppercase d-block mb-1">
                Code
            </small>
            <div class="fw-semibold">
                <%= teacherClass.classCode %>
            </div>
        </div>

    </div>

</div>

<div class="bg-white rounded-4 shadow-sm border p-4 mb-4">
    <h4 class="fw-bold mb-3">Student List</h4>

    <% if (teacherClass.students.length > 0) { %>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">

                <thead>
                    <tr>
                        <th>Student Name</th>
                        <th>Parent</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    <% teacherClass.students.forEach(student => { %>

                        <tr>
                            <td><%= student.name %></td>

                            <td>
                                <%= student.parent.name %>
                            </td>

                            <td>
                                <% if (student.status === "Active") { %>
                                    <span class="badge bg-success">Active</span>
                                <% } else if (student.status === "Pending") { %>
                                    <span class="badge bg-warning text-dark">Pending</span>
                                <% } else { %>
                                    <span class="badge bg-secondary">Removed</span>
                                <% } %>
                            </td>

                            <td class="text-end">

                                <% if (student.status === "Pending") { %>
                                    <a
                                        href="#"
                                        class="btn btn-outline-success btn-sm me-1 approve-student-btn"
                                        data-student-id="<%= student._id %>">

                                        Approve

                                    </a>
                                <% } %>

                                <% if (student.status === "Active") { %>
                                    <%- include("../partials/modalForms/addFeedback", {
                                        student,
                                        teacherClass
                                    }) %>
                                    <button
                                        type="button"
                                        class="btn btn-sm me-1 add-feedback-btn"
                                        data-bs-toggle="modal"
                                        data-bs-target="#feedbackModal-<%= student._id %>">

                                        <i class="fa-regular fa-pen-to-square text-primary fs-5"></i>

                                    </button>
                                <% } %>

                                <button
                                type="button"
                                class="btn btn-sm delete-student-btn"
                                data-student-id="<%= student._id %>">

                                    <i class="fa-solid fa-trash text-danger"></i>

                                </button>

                            </td>
                        </tr>

                    <% }) %>
                </tbody>

            </table>
        </div>

    <% } else { %>

        <p class="text-muted mb-0">
            No students have been linked to this class yet.
        </p>

    <% } %>
</div>

<div class="bg-white rounded-4 shadow-sm border p-4 mb-4">

    <div class="row g-4">

        <!-- Tasks -->
        <div class="col-md-4">
            <div class="border rounded-4 p-4 h-100 shadow-sm">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h5 class="fw-bold mb-1">Tasks</h5>
                        <p class="text-muted small mb-0">
                            Parent forms, permissions, and action items.
                        </p>
                    </div>

                    <span class="badge bg-secondary rounded-pill">
                        <%= teacherClass.bulletins.length %>
                    </span>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button
                        type="button"
                        class="btn btn-secondary flex-fill"
                        data-bs-toggle="modal"
                        data-bs-target="#addTaskModal"
                    >
                    <i class="fa-solid fa-plus"></i>
                    Quick Add
                    </button>

                    <button
                        type="button"
                        class="btn btn-secondary flex-fill"
                    >
                        Open Tasks
                    </button>
                </div>
            </div>
        </div>

        <!-- Homework -->
        <div class="col-md-4">
            <div class="border rounded-4 p-4 h-100 shadow-sm">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h5 class="fw-bold mb-1">Homework Journal</h5>
                        <p class="text-muted small mb-0">
                            Add homework notes and class learning activities.
                        </p>
                    </div>

                    <span class="badge bg-success rounded-pill">
                        <%= currentWeek.dailyHomework.length %>
                    </span>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button
                        type="button"
                        class="btn btn-success flex-fill"
                        data-bs-toggle="modal"
                        data-bs-target="#addHomeworkModal"
                    >
                        <i class="fa-solid fa-plus"></i>
                        Quick Add
                    </button>

                    <button
                        type="button"
                        class="btn btn-success flex-fill"
                    >
                        Open Homework
                    </button>
                </div>
            </div>
        </div>

        <!-- Bulletin -->
        <div class="col-md-4">
            <div class="border rounded-4 p-4 h-100 shadow-sm">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h5 class="fw-bold mb-1">Bulletin</h5>
                        <p class="text-muted small mb-0">
                            Post classroom updates and announcements.
                        </p>
                    </div>

                    <span class="badge bg-warning text-dark rounded-pill">
                        <%= teacherClass.bulletins.length %>
                    </span>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button
                        type="button"
                        class="btn btn-warning flex-fill"
                        data-bs-toggle="modal"
                        data-bs-target="#addBulletinModal"
                    >
                        <i class="fa-solid fa-plus"></i>
                        Quick Add
                    </button>

                    <button
                        type="button"
                        class="btn btn-warning flex-fill"
                        href="/parent/dashboard/bulletin"
                    >
                        Open Bulletins
                    </button>
                </div>
            </div>
        </div>

    </div>
</div>

<div class="bg-white rounded-4 shadow-sm border p-4 mb-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0">Subjects</h4>

        <button
            type="button"
            class="btn btn-primary btn-sm"
            data-bs-toggle="modal"
            data-bs-target="#addSubjectModal"
        >
            Add Subject
        </button>
    </div>

    <% if (teacherClass.subjects && teacherClass.subjects.length > 0) { %>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">

                <thead>
                    <tr>
                        <th>Subject Name</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    <% teacherClass.subjects.forEach(subject => { %>

                        <tr>
                            <td>
                                <%= subject.name %>
                            </td>

                            <td class="text-end">
                                <button
                                    type="button"
                                    class="btn btn-sm edit-subject-btn"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editSubjectModal"
                                    data-subject-id="<%= subject._id %>"
                                    data-subject-name="<%= subject.name %>"
                                >
                                
                                    <i class="fa-solid fa-gear text-secondary"></i>

                                </button>

                                <button
                                    type="button"  
                                    class="btn btn-sm delete-subject-btn" 
                                    data-subject-id="<%= subject._id %>"
                                >
                                    
                                    <i class="fa-solid fa-trash text-danger"></i>

                                </button>
                            </td>
                        </tr>

                    <% }) %>
                </tbody>

            </table>
        </div>

    <% } else { %>

        <p class="text-muted mb-0">
            No subjects have been added to this class yet.
        </p>

    <% } %>

</div>