<div class="dashboard-hero bg-white rounded-4 shadow-sm border mb-4 p-4 p-md-5">

    <div class="row align-items-center g-4">

        <div class="col-md-8">

            <span class="badge rounded-pill text-bg-light border mb-3">
                Teacher Dashboard
            </span>

            <h1 class="fw-bold mb-2">
                Welcome <%= user.name %>
            </h1>

            <p class="text-muted mb-0">
                Manage students, weekly feedback, homework, tasks, and classroom updates from one place.
            </p>

        </div>

        <% if (currentWeek) { %>

            <div class="col-md-4">

                <div class="current-week-card rounded-4 border p-3 text-md-end bg-light">

                    <p class="text-muted small fw-semibold mb-1">
                        Current Week
                    </p>

                    <h6 class="fw-bold mb-0">
                        <%= currentWeek.weekStartDate.toDateString() %>
                    </h6>

                    <p class="text-muted small mb-0">
                        to <%= currentWeek.weekEndDate.toDateString() %>
                    </p>

                </div>

            </div>

        <% } %>

    </div>

</div>

<div class="bg-white rounded-4 shadow-sm border p-4 mb-4">
    <h4 class="fw-bold mb-3">Class Overview</h4>

    <div class="row g-3">

        <div class="col-md-4">
            <div class="border rounded-4 p-3 h-100">
                <h6 class="fw-bold">Class</h6>
                <p class="text-muted mb-0">
                    <%= teacherClass.name %>
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="border rounded-4 p-3 h-100">
                <h6 class="fw-bold">Students</h6>
                <p class="text-muted mb-0">
                    <%= teacherClass.students.length %> enrolled
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="border rounded-4 p-3 h-100">
                <h6 class="fw-bold">Class Code</h6>
                <p class="text-muted mb-0">
                    <%= teacherClass.classCode %>
                </p>
            </div>
        </div>

    </div>
</div>

<div class="bg-white rounded-4 shadow-sm border p-4 mb-4">
    <h4 class="fw-bold mb-3">Student List</h4>

    <% if (teacherClass.students.length > 0) { %>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">

                <thead>
                    <tr>
                        <th>Student Name</th>
                        <th>Parent</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    <% teacherClass.students.forEach(student => { %>

                        <tr>
                            <td><%= student.name %></td>

                            <td>
                                <%= student.parent.name %>
                            </td>

                            <td>
                                <% if (student.status === "Active") { %>
                                    <span class="badge bg-success">Active</span>
                                <% } else if (student.status === "Pending") { %>
                                    <span class="badge bg-warning text-dark">Pending</span>
                                <% } else { %>
                                    <span class="badge bg-secondary">Removed</span>
                                <% } %>
                            </td>

                            <td class="text-end">

                                <% if (student.status === "Pending") { %>
                                    <a
                                        href="#"
                                        class="btn btn-outline-success btn-sm me-1 approve-student-btn"
                                        data-student-id="<%= student._id %>">

                                        Approve

                                    </a>
                                <% } %>

                                <% if (student.status === "Active") { %>
                                    <%- include("../partials/modalForms/addFeedback", {
                                        student,
                                        teacherClass
                                    }) %>
                                    <button
                                        type="button"
                                        class="btn btn-sm me-1 add-feedback-btn"
                                        data-bs-toggle="modal"
                                        data-bs-target="#feedbackModal-<%= student._id %>">

                                        <i class="fa-regular fa-pen-to-square text-primary fs-5"></i>

                                    </button>
                                <% } %>

                                <button
                                type="button"
                                class="btn btn-sm delete-student-btn"
                                data-student-id="<%= student._id %>">

                                    <i class="fa-solid fa-trash text-danger"></i>

                                </button>

                            </td>
                        </tr>

                    <% }) %>
                </tbody>

            </table>
        </div>

    <% } else { %>

        <p class="text-muted mb-0">
            No students have been linked to this class yet.
        </p>

    <% } %>
</div>

<div class="bg-white rounded-4 shadow-sm border p-4 mb-4">
    <h4 class="fw-bold mb-4">Quick Add</h4>

    <div class="row g-4">

        <!-- Tasks -->
        <div class="col-md-4">
            <div class="border rounded-4 p-4 h-100 shadow-sm">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h5 class="fw-bold mb-1">Tasks</h5>
                        <p class="text-muted small mb-0">
                            Parent forms, permissions, and action items.
                        </p>
                    </div>

                    <span class="badge bg-secondary rounded-pill">
                        <%= teacherClass.tasks.length %>
                    </span>
                </div>

                <button
                    type="button"
                    class="btn btn-secondary w-100 mt-3"
                    data-bs-toggle="modal"
                    data-bs-target="#addTaskModal"
                >
                    Add Task
                </button>
            </div>
        </div>

        <!-- Homework -->
        <div class="col-md-4">
            <div class="border rounded-4 p-4 h-100 shadow-sm">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h5 class="fw-bold mb-1">Homework Journal</h5>
                        <p class="text-muted small mb-0">
                            Add homework notes and class learning activities.
                        </p>
                    </div>

                    <span class="badge bg-success rounded-pill">
                        <%= currentWeek.dailyHomework.length %>
                    </span>
                </div>

                <button
                    type="button"
                    class="btn btn-success w-100 mt-3"
                    data-bs-toggle="modal"
                    data-bs-target="#addHomeworkModal"
                >
                    Add Homework
                </button>
            </div>
        </div>

        <!-- Bulletin -->
        <div class="col-md-4">
            <div class="border rounded-4 p-4 h-100 shadow-sm">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h5 class="fw-bold mb-1">Bulletin</h5>
                        <p class="text-muted small mb-0">
                            Post classroom updates and announcements.
                        </p>
                    </div>

                    <span class="badge bg-warning text-dark rounded-pill">
                        <%= teacherClass.bulletins.length %>
                    </span>
                </div>

                <button
                    type="button"
                    class="btn btn-warning w-100 mt-3"
                    data-bs-toggle="modal"
                    data-bs-target="#addBulletinModal"
                >
                    Add Bulletin
                </button>
            </div>
        </div>

    </div>
</div>

<div class="bg-white rounded-4 shadow-sm border p-4 mb-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0">Subjects</h4>

        <button
            type="button"
            class="btn btn-primary btn-sm"
            data-bs-toggle="modal"
            data-bs-target="#addSubjectModal"
        >
            Add Subject
        </button>
    </div>

    <% if (teacherClass.subjects && teacherClass.subjects.length > 0) { %>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">

                <thead>
                    <tr>
                        <th>Subject Name</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    <% teacherClass.subjects.forEach(subject => { %>

                        <tr>
                            <td>
                                <%= subject.name %>
                            </td>

                            <td class="text-end">
                                <button
                                    type="button"
                                    class="btn btn-sm edit-subject-btn"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editSubjectModal"
                                    data-subject-id="<%= subject._id %>"
                                    data-subject-name="<%= subject.name %>"
                                >
                                
                                    <i class="fa-solid fa-gear text-secondary"></i>

                                </button>

                                <button
                                    type="button"  
                                    class="btn btn-sm delete-subject-btn" 
                                    data-subject-id="<%= subject._id %>"
                                >
                                    
                                    <i class="fa-solid fa-trash text-danger"></i>

                                </button>
                            </td>
                        </tr>

                    <% }) %>
                </tbody>

            </table>
        </div>

    <% } else { %>

        <p class="text-muted mb-0">
            No subjects have been added to this class yet.
        </p>

    <% } %>

</div>