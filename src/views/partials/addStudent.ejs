<!-- Main Content -->
<h2 class="fw-bold mb-4 text-center">
    Join Class
</h2>

<p class="text-muted text-center mb-4">
    Join an existing class by entering the class code provided by your teacher and adding a student.
</p>

<form id="addStudentForm" method="POST" action="/api/parent/join-class">

    <div class="mb-3">

        <label class="form-label fw-semibold">
            Class Code
        </label>

        <input
            type="text"
            name="classCode"
            class="form-control form-control-lg"
            required
        >

         <label class="form-label fw-semibold">
            Student Name
        </label>

        <input
            type="text"
            name="name"
            class="form-control form-control-lg"
            required
        >

    </div>

    <button class="btn btn-primary w-100 py-2 fw-semibold">

        Join Class

    </button>

</form>