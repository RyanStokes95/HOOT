<form id="addTaskForm" action="/api/teacher/create-task" method="POST">

    <div class="mb-3">

        <label class="form-label fw-semibold">
            Name
        </label>

        <input
            type="text"
            name="title"
            class="form-control rounded-3"
            placeholder="Enter task name"
            required
        >

        <label class="form-label fw-semibold">
            Description
        </label>

        <input
            type="text"
            name="description"
            class="form-control rounded-3"
            placeholder="Enter task description"
            required
        >

        <label for="assignedTo" class="form-label fw-semibold">
        <label class="form-label fw-semibold">
            Assigned To
        </label>

        <div class="custom-dropdown" id="parentDropdown">

            <button type="button" class="dropdown-trigger">
                Select Parents
                <i class="fa-solid fa-chevron-down"></i>
            </button>

            <div class="dropdown-panel">

                <% teacherClass.students.forEach(student => { %>
                    <% if (student.parent && student.status === "Active") { %>

                        <label class="dropdown-item">
                            <input
                                type="checkbox"
                                name="assignedTo"
                                value="<%= student.parent._id %>">

                            <span>
                                <%= student.parent.name %> — <%= student.name %>
                            </span>
                        </label>

                    <% } %>
                <% }) %>

            </div>
        </div>

        <label class="form-label fw-semibold">
            Due Date
        </label>

        <input
            type="text"
            name="dueDate"
            class="form-control rounded-3"
            placeholder="Enter due date (YYYY-MM-DD)"
            required
        >

    </div>


    <div class="d-flex justify-content-end gap-2">

        <button
            type="button"
            class="btn btn-light border"
            data-bs-dismiss="modal"
        >
            Cancel
        </button>

        <button type="submit" class="btn btn-primary">
            Add Task
        </button>

    </div>

</form>