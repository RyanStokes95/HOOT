<!-- Author - Ryan Stokes -->
<!-- editTask.ejs -->


<form id="editTaskForm" action="/api/teacher/edit-task" method="POST">

    <!-- Hidden input to store the task ID for editing, is needed for the update operation -->
    <input type="hidden" id="editTaskId" name="taskId">

    <div class="mb-3">
        <label class="form-label fw-semibold">Name</label>

        <input
            type="text"
            id="editTaskTitle"
            name="title"
            class="form-control rounded-3"
            required
        >

        <label class="form-label fw-semibold">Description</label>

        <textarea
            id="editTaskContent"
            name="description"
            class="form-control rounded-3"
            rows="4"
            required
        ></textarea>

        <label class="form-label fw-semibold">Assigned To</label>

        <div class="custom-dropdown" id="parentDropdown">

            <button type="button" class="dropdown-trigger">
                Select Parents
                <i class="fa-solid fa-chevron-down"></i>
            </button>

            <div class="dropdown-panel">

                <% teacherClass.students.forEach(student => { %>
                    <% if (student.parent && student.status === "Active") { %>

                        <label class="dropdown-item">
                            <input
                                type="checkbox"
                                name="assignedTo"
                                value="<%= student.parent._id %>">

                            <span>
                                <%= student.parent.name %> — <%= student.name %>
                            </span>
                        </label>
                    <% } %>
                <% }); %>

            </div>

            <label class="form-label fw-semibold mt-2">Due Date</label>

            <input
                type="date"
                id="editTaskDueDate"
                name="dueDate"
                class="form-control rounded-3"
                required
            >
    </div>



    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-light border" data-bs-dismiss="modal">
            Cancel
        </button>

        <button type="submit" class="btn btn-primary">
            Save Changes
        </button>
    </div>

</form>