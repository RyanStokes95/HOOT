<!-- Author - Ryan Stokes -->
<!-- editTask.ejs -->

<form id="editTaskForm" action="/api/teacher/edit-task" method="POST">

    <!-- Hidden input to store the task ID for editing -->
    <input type="hidden" id="editTaskId" name="taskId">

    <div class="mb-3">
        <label class="form-label fw-semibold" for="editTaskTitle">Name</label>
        <input
            type="text"
            id="editTaskTitle"
            name="title"
            class="form-control rounded-3"
            required
        >
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold" for="editTaskDescription">Description</label>
        <textarea
            id="editTaskDescription"
            name="description"
            class="form-control rounded-3"
            rows="4"
            required
        ></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">Assigned To</label>

        <div class="custom-dropdown" id="editParentDropdown">

            <button type="button" class="dropdown-trigger">
                Select Parents
                <i class="fa-solid fa-chevron-down"></i>
            </button>

           <div class="dropdown-panel">

                <% const displayedParents = new Set(); %>

                <% teacherClass.students.forEach(student => { %>
                    <% if (
                        student.parent &&
                        student.status === "Active" &&
                        !displayedParents.has(student.parent._id.toString())
                    ) { %>

                        <% displayedParents.add(student.parent._id.toString()); %>

                        <label class="dropdown-item">
                            <input
                                type="checkbox"
                                name="assignedTo"
                                value="<%= student.parent._id %>"
                            >

                            <span><%= student.parent.name %></span>
                        </label>

                    <% } %>
                <% }); %>

            </div>

        </div>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold" for="editTaskDueDate">Due Date</label>

        <input
            type="date"
            id="editTaskDueDate"
            name="dueDate"
            class="form-control rounded-3"
            required
        >
    </div>

    <div class="d-flex justify-content-end gap-2">
        <button
            type="button"
            class="btn btn-light border"
            data-bs-dismiss="modal"
        >
            Cancel
        </button>

        <button
            type="submit"
            class="btn btn-primary"
        >
            Save Changes
        </button>
    </div>

</form>