<form id="addClassForm" method="POST" action="/api/teacher/create-class">

    <div class="mb-3">

        <label class="form-label fw-semibold">
            Class Name
        </label>

        <input
            type="text"
            name="name"
            class="form-control form-control-lg"
            placeholder="e.g. 4th Class A"
            required
        >

    </div>

    <button class="btn btn-primary w-100 py-2 fw-semibold">

        Create Class

    </button>

</form>