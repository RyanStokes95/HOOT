<!-- Author - Ryan Stokes -->
<!-- editHomework.ejs -->


<form id="editHomeworkForm" action="/api/teacher/edit-homework" method="POST">

    <!-- Hidden input to store the homework ID for editing, is needed for the update operation -->
    <input type="hidden" id="editHomeworkId" name="homeworkId">

    <div class="mb-3">
        <label class="form-label fw-semibold">Homework Title</label>

        <input
            type="text"
            id="editHomeworkTitle"
            name="title"
            class="form-control rounded-3"
            required
        >
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">Homework Description</label>

        <textarea
            id="editHomeworkDescription"
            name="description"
            class="form-control rounded-3"
            rows="4"
            required
        ></textarea>
    </div>

    <label class="form-label fw-semibold">
        Subject
    </label>

    <select
        class="form-select"
        name="subject"
        required>

        <option value="" selected disabled>
            Select Subject
        </option>

        <%
            let subjects = [];

            if (teacherClass && teacherClass.subjects) {
                subjects = teacherClass.subjects;
            }
        %>

            <% subjects.forEach(subject => { %>

                <option value="<%= subject._id %>">
                    <%= subject.name %>
                </option>

            <% }) %>

            <% if (subjects.length === 0) { %>

                <option disabled>
                    No subjects available
                </option>

            <% } %>

    </select>

    <div class="mb-3">
        <label class="form-label fw-semibold">Due Date</label>

        <input
            type="date"
            id="editHomeworkDueDate"
            name="dueDate"
            class="form-control rounded-3"
            required
        >
    </div>

    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-light border" data-bs-dismiss="modal">
            Cancel
        </button>

        <button type="submit" class="btn btn-primary">
            Save Changes
        </button>
    </div>

</form>