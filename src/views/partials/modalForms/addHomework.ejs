<!-- addHomework.ejs -->

<form id="addHomeworkForm" action="/api/teacher/add-homework" method="POST">

    <div class="mb-3">

        <label class="form-label fw-semibold">
            Title
        </label>

        <input
            type="text"
            name="title"
            class="form-control rounded-3"
            placeholder="Enter homework title"
            required
        >

        <label class="form-label fw-semibold">
            Description
        </label>

        <input
            type="text"
            name="description"
            class="form-control rounded-3"
            placeholder="Enter homework description"
            required
        >

        <label class="form-label fw-semibold">
            Subject
        </label>

        <select
            class="form-select"
            name="subject"
            required>

            <option value="" selected disabled>
                Select Subject
            </option>

           <%
                let subjects = [];

                if (teacherClass && teacherClass.subjects) {
                    subjects = teacherClass.subjects;
                }
            %>

                <% subjects.forEach(subject => { %>

                    <option value="<%= subject._id %>">
                        <%= subject.name %>
                    </option>

                <% }) %>

                <% if (subjects.length === 0) { %>

                    <option disabled>
                        No subjects available
                    </option>

                <% } %>

        </select>

        <label class="form-label fw-semibold">
            Due Date
        </label>

        <input
            type="text"
            name="dueDate"
            class="form-control rounded-3"
            placeholder="Enter due date (YYYY-MM-DD)"
            required
        >

    </div>


    <div class="d-flex justify-content-end gap-2">

        <button
            type="button"
            class="btn btn-light border"
            data-bs-dismiss="modal"
        >
            Cancel
        </button>

        <button type="submit" class="btn btn-success">
            Add Homework
        </button>

    </div>

</form>