<!-- Author: Ryan Stokes -->
<!-- homework.ejs -->

<div class="card border-0 shadow-sm">
    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5 class="fw-bold mb-0">Homework</h5>
                <small class="text-muted">
                    Manage class Homework
                </small>
            </div>

            <button
                class="btn btn-sm btn-success"
                data-bs-toggle="modal"
                data-bs-target="#addHomeworkModal"
            >
                Add Homework
            </button>
        </div>

        <% if (currentWeek.dailyHomework.length === 0) { %>

            <div class="text-center py-4">
                <small class="text-muted">No dailyHomework yet</small>
            </div>

        <% } else { %>

            <div class="list-group">

                <% currentWeek.dailyHomework.forEach(dailyHomework => { %>

                    <div class="list-group-item border-0 border-bottom py-3 px-0">

                        <div class="d-flex justify-content-between align-items-start">

                            <div class="me-3 flex-grow-1">

                                <div class="fw-semibold">
                                    <%= dailyHomework.day %>
                                </div>

                                <div class="fw-semibold">
                                    <%= dailyHomework.title %>
                                </div>

                                <div class="text-muted small">
                                    <%= dailyHomework.description || 'No description' %>
                                </div>

                                <div class="fw-semibold">
                                    <%= dailyHomework.subjectName %>
                                </div>

                            </div>

                            <div class="text-end" style="min-width: 180px;">

                                <div class="small text-muted">
                                    Due Date
                                </div>

                                <div class="fw-semibold small mb-2">
                                    <%= dailyHomework.dueDate
                                        ? new Date(dailyHomework.dueDate).toLocaleDateString()
                                        : '—' %>
                                </div>

                                <div class="d-flex justify-content-end gap-2">

                                    <button
                                        class="btn btn-sm edit-homework-btn"
                                        data-task-id="<%= dailyHomework._id %>"
                                    >
                                        <i class="fa-solid fa-gear text-secondary"></i>
                                    </button>

                                    <form
                                        method="POST"
                                        action="/homework/<%= dailyHomework._id %>/delete"
                                    >
                                        <button
                                            type="submit"
                                            class="btn btn-sm delete-homework-btn"
                                            data-homework-id="<%= dailyHomework._id %>"
                                        >
                                            <i class="fa-solid fa-trash text-danger"></i>
                                        </button>
                                    </form>

                                </div>

                            </div>

                        </div>

                    </div>

                <% }) %>

            </div>

        <% } %>

    </div>
</div>