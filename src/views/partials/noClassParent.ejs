<!-- noClassParent.ejs -->

<!-- Main Content -->

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="bg-white rounded-4 shadow-sm border p-5 text-center">

                <div class="mb-4">
                    <i class="bi bi-person-x display-1 text-secondary"></i>
                </div>

                <h1 class="fw-bold mb-3">
                    No Children Linked
                </h1>

                <p class="text-muted fs-5 mb-4">
                    You currently do not have any children linked to your parent account.
                    Join a class using the class code provided by the teacher to begin
                    viewing homework, tasks, bulletins, and weekly progress updates.
                </p>

                <div class="d-flex justify-content-center gap-3 flex-wrap">

                    <button
                        type="button"
                        class="btn btn-primary btn-lg px-4 rounded-3"
                        data-bs-toggle="modal"
                        data-bs-target="#addStudentModal"
                    >
                        Join Class

                    </button>

                    <a id="logoutBtn" href="/login"
                       class="btn btn-outline-secondary btn-lg px-4 rounded-3">
                        Logout
                    </a>

                </div>

            </div>

            <div class="bg-light border rounded-4 p-4 mt-4">

                <h5 class="fw-bold mb-3">
                    What you can do once linked
                </h5>

                <div class="row g-3">

                    <div class="col-md-6">
                        <div class="border rounded-3 p-3 h-100 bg-white">
                            <h6 class="fw-bold">View Homework</h6>
                            <p class="text-muted mb-0">
                                See homework tasks assigned by the teacher.
                            </p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="border rounded-3 p-3 h-100 bg-white">
                            <h6 class="fw-bold">Track Progress</h6>
                            <p class="text-muted mb-0">
                                Review weekly student reports and performance updates.
                            </p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="border rounded-3 p-3 h-100 bg-white">
                            <h6 class="fw-bold">Receive Bulletins</h6>
                            <p class="text-muted mb-0">
                                Read class announcements and teacher updates.
                            </p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="border rounded-3 p-3 h-100 bg-white">
                            <h6 class="fw-bold">Monitor Tasks</h6>
                            <p class="text-muted mb-0">
                                Keep track of actions, permissions, and school-related tasks.
                            </p>
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div> 