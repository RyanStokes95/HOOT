<!-- auth.ejs -->

<!-- This is the authentication page for handling user login and registration, will be injected into the main layout -->
 
<!-- Main Content -->
<body class="bg-light">

  <div class="container min-vh-100 d-flex align-items-center justify-content-center">

    <div class="col-md-5">

      <div class="card shadow-lg border-0">

        <div class="card-body p-4">

          <% if (role === "teacher") { %>

            <%- include("./partials/registerTeacher") %>

          <% } else if (role === "parent") { %>

            <%- include("./partials/registerParent") %>

          <% } else { %>

            <%- include("./partials/login") %>

          <% } %>

        </div>

      </div>

    </div>

  </div>

</body>