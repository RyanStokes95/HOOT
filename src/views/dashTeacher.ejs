<div class="p-5 bg-white rounded-4 shadow-sm border mb-4">
  <h1 class="display-6 fw-bold">Welcome to the Teacher Dashboard</h1>
  <p class="text-muted mt-3 mb-0">
    Manage your class, students, tasks, homework journal, and bulletin updates.
  </p>
</div>

<!-- Class Overview -->
<div class="bg-white rounded-4 shadow-sm border p-4 mb-4">
  <h4 class="fw-bold mb-3">Class Overview</h4>

  <div class="row g-3">
    <div class="col-md-4">
      <div class="border rounded-4 p-3 h-100">
        <h6 class="fw-bold">Class</h6>
        <p class="text-muted mb-0">4th Class A</p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="border rounded-4 p-3 h-100">
        <h6 class="fw-bold">Students</h6>
        <p class="text-muted mb-0">24 enrolled</p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="border rounded-4 p-3 h-100">
        <h6 class="fw-bold">Class Code</h6>
        <p class="text-muted mb-0">H7K92Q</p>
      </div>
    </div>
  </div>
</div>

<!-- Student List -->
<div class="bg-white rounded-4 shadow-sm border p-4 mb-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0">Student List</h4>
    <a href="#" class="btn btn-primary btn-sm">Add Student</a>
  </div>

  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>Student Name</th>
          <th>Parent</th>
          <th>Status</th>
          <th class="text-end">Action</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Emma Byrne</td>
          <td>Sarah Byrne</td>
          <td><span class="badge bg-success">Approved</span></td>
          <td class="text-end">
            <a href="#" class="btn btn-outline-primary btn-sm">View</a>
          </td>
        </tr>

        <tr>
          <td>Jack Murphy</td>
          <td>David Murphy</td>
          <td><span class="badge bg-warning text-dark">Pending</span></td>
          <td class="text-end">
            <a href="#" class="btn btn-outline-success btn-sm">Approve</a>
          </td>
        </tr>

        <tr>
          <td>Sophie Kelly</td>
          <td>Laura Kelly</td>
          <td><span class="badge bg-success">Approved</span></td>
          <td class="text-end">
            <a href="#" class="btn btn-outline-primary btn-sm">View</a>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<!-- Quick Actions -->
<div class="row g-4 mb-4">

  <!-- Add Task -->
  <div class="col-md-6">
    <div class="bg-white rounded-4 shadow-sm border p-4 h-100">
      <h4 class="fw-bold">Add Task</h4>
      <p class="text-muted">
        Create a task, form, permission request, or action item for parents.
      </p>
      <a href="#" class="btn btn-primary btn-sm">Create Task</a>
    </div>
  </div>

  <!-- Add Homework -->
  <div class="col-md-6">
    <div class="bg-white rounded-4 shadow-sm border p-4 h-100">
      <h4 class="fw-bold">Add Homework Journal</h4>
      <p class="text-muted">
        Add homework notes and learning activities for the class.
      </p>
      <a href="#" class="btn btn-primary btn-sm">Add Homework</a>
    </div>
  </div>

  <!-- Add Performance -->
  <div class="col-md-6">
    <div class="bg-white rounded-4 shadow-sm border p-4 h-100">
      <h4 class="fw-bold">Add Performance Update</h4>
      <p class="text-muted">
        Record weekly progress, grades, and feedback for students.
      </p>
      <a href="#" class="btn btn-primary btn-sm">Add Performance</a>
    </div>
  </div>

  <!-- Add Bulletin -->
  <div class="col-md-6">
    <div class="bg-white rounded-4 shadow-sm border p-4 h-100">
      <h4 class="fw-bold">Add Bulletin</h4>
      <p class="text-muted">
        Post classroom updates, announcements, and teacher messages.
      </p>
      <a href="#" class="btn btn-primary btn-sm">Create Bulletin</a>
    </div>
  </div>

</div>