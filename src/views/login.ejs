<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>HOOT | Login</title>
    <!-- Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>

  <body class="bg-light">
    <!-- Navigation Bar -->
    <nav class="navbar navbar-dark bg-dark">
      <div class="container">
        <a class="navbar-brand fw-bold" href="/">HOOT</a>

        <div class="ms-auto d-flex gap-2">
          <a class="btn btn-outline-light btn-sm" href="/login">Login</a>
          <a class="btn btn-warning btn-sm" href="/register">Register</a>
          <a class="btn btn-outline-danger btn-sm" href="/logout">Logout</a>
        </div>
      </div>
    </nav>
    <!-- Main Content -->
    <div class="container min-vh-100 d-flex align-items-center justify-content-center">
      <div class="col-md-5">

        <div class="card shadow-sm border-0">
          <div class="card-body p-4">

            <h3 class="text-center mb-4">Login</h3>

            <form method="POST" action="/api/auth/login">

              <div class="mb-3">
                <label class="form-label">Email</label>
                <input 
                  type="email" 
                  name="email" 
                  class="form-control" 
                  required
                />
              </div>

              <div class="mb-3">
                <label class="form-label">Password</label>
                <input 
                  type="password" 
                  name="password" 
                  class="form-control" 
                  required
                />
              </div>

              <button class="btn btn-dark w-100">
                Login
              </button>

            </form>

            <p class="text-center mt-3 text-muted small">
              Don’t have an account? <a href="/register">Register</a>
            </p>

          </div>
        </div>

      </div>
    </div>
    <!-- Bootstrap JavaScript Bundle with Popper -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    ></script>
  </body>
</html>